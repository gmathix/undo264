{
  "version": 6,
  "configurePresets": [
    {
      "name": "release",
      "displayName": "Release (Unix Makefiles)",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/release",
      "condition": { "type": "notEquals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "USE_NATIVE_ARCH": "ON"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug (Unix Makefiles)",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/debug",
      "condition": { "type": "notEquals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "USE_NATIVE_ARCH": "OFF"
      }
    },
    {
      "name": "debug_sanitize",
      "displayName": "Debug + sanitizers (ASan+UBSan by default; override with -DENABLE_*)",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/debug_sanitize",
      "condition": { "type": "notEquals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "USE_NATIVE_ARCH": "OFF",
        "ENABLE_ASAN": "ON",
        "ENABLE_UBSAN": "ON",
        "ENABLE_MSAN": "OFF"
      }
    },
    {
      "name": "replay_targets",
      "displayName": "Replay targets: ASan / UBSan / MSan (Clang, Linux)",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/replay_targets",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "USE_NATIVE_ARCH": "OFF",
        "UNDO264_COMPILER": "clang",
        "BUILD_REPLAY_TARGETS": "ON",
        "BUILD_TOOLS": "OFF"
      }
    },
    {
      "name": "win-release",
      "displayName": "Windows Release (Ninja, MinGW GCC/Clang)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/win-release",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "USE_NATIVE_ARCH": "ON",
        "COPY_MINGW_RUNTIME": "ON"
      }
    },
    {
      "name": "win-debug",
      "displayName": "Windows Debug (Ninja, MinGW GCC/Clang)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/win-debug",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "USE_NATIVE_ARCH": "OFF",
        "COPY_MINGW_RUNTIME": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "release", "configurePreset": "release" },
    { "name": "debug", "configurePreset": "debug" },
    { "name": "debug_sanitize", "configurePreset": "debug_sanitize" },
    { "name": "replay_targets", "configurePreset": "replay_targets", "targets": ["replay_asan", "replay_ubsan", "replay_msan"]},
    { "name": "win-release", "configurePreset": "win-release" },
    { "name": "win-debug", "configurePreset": "win-debug" }
  ]
}