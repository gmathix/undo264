{
  "version": 6,
  "configurePresets": [
    {
      "name": "release",
      "displayName": "Release (Unix Makefiles)",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/release",
      "condition": { "type": "notEquals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "USE_NATIVE_ARCH": "ON"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug (Unix Makefiles)",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/debug",
      "condition": { "type": "notEquals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "USE_NATIVE_ARCH": "OFF"
      }
    },
    {
      "name": "debug_asan",
      "displayName": "Debug + sanitizers (Unix Makefiles)",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/debug_asan",
      "condition": { "type": "notEquals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "DebugASAN",
        "SANITIZE": "address,undefined",
        "USE_NATIVE_ARCH": "OFF"
      }
    },
    {
      "name": "replay_main",
      "displayName": "Debug + sanitizers (Unix Makefiles) with Clang",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/replay_main",
      "condition": { "type": "notEquals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "DebugASAN",
        "SANITIZE": "address,undefined",
        "USE_NATIVE_ARCH": "OFF",
        "BUILD_FUZZERS": "ON",
        "UNDO264_COMPILER": "clang"
      }
    },
    {
      "name": "win-release",
      "displayName": "Windows Release (Ninja, MinGW GCC/Clang)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/win-release",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "USE_NATIVE_ARCH": "ON",
        "COPY_MINGW_RUNTIME": "ON"
      }
    },
    {
      "name": "win-debug",
      "displayName": "Windows Debug (Ninja, MinGW GCC/Clang)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/win-debug",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "USE_NATIVE_ARCH": "OFF",
        "COPY_MINGW_RUNTIME": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "release", "configurePreset": "release" },
    { "name": "debug", "configurePreset": "debug" },
    { "name": "win-release", "configurePreset": "win-release" },
    { "name": "win-debug", "configurePreset": "win-debug" }
  ]
}